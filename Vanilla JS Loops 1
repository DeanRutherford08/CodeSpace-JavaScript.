// This program goes from 0 to 15
// and checks if each number is odd or even

for (var i = 0; i <= 15; i++) {

    // check if the number is even
    if (i % 2 === 0) {
        console.log(i + " is even");
    }
    // otherwise it must be odd
    else {
        console.log(i + " is odd");
    }
}
