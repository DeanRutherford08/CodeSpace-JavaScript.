<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Activity 2 - Vanilla JS DOM</title>
</head>
<body>
    <p>Input radius value and get the volume of a sphere.</p>

    <label>Radius</label>
    <input type="text" id="radius">

    <br><br>

    <label>Volume</label>
    <input type="text" id="volume">

    <br><br>

    <button onclick="calculateVolume()">Calculate</button>

    <script>
        function calculateVolume() {
            var r = document.getElementById("radius").value;
            r = Number(r);
            var v = (4/3) * Math.PI * r * r * r;
            document.getElementById("volume").value = v.toFixed(2);
        }
    </script>
</body>
</html>
